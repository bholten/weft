let greek_words (
    philosophy psychology theology theory thesis hypothesis
    logic ethics physics analysis diagnosis idea ideal
    method system problem democracy phenomenon paradigm paradox
    biology geology geography technology mathematics chemistry anatomy
    therapy atom graph cycle phone telephone program automatic
    character school church angel demon icon symbol music theater
    athlete photograph energy crisis basis emphasis
)

;; === Helper: Check if word is in list (case-insensitive) ===

proc word_in_list {word lst} {
    let lower_word [String::lower $word]
    foreach w $lst {
        if [== $lower_word $w] { return 1 }
    }
    return 0
}

;; === Main Logic ===

;; Add a ViewLayer for the "etymology" annotation layer so it renders
;; Priority 50 puts it above plumb (5) but below search (10) and style (100)
weft::viewlayer::add "annot" "etymology" 50

;; Clear previous etymology annotations
weft::annot::clear-layer "etymology"

;; Get all words as spans and annotate by etymology
var word_count 0

foreach w [words [buffer]] {
    let txt [get $w "text"]

    if [word_in_list $txt $germanic_words] {
        if [== $word_count 0] {
            puts "DEBUG: first span = $w"
            puts "DEBUG: calling annot-span with layer=etymology, fg=$color_germanic"
        }
        set! word_count [+ $word_count 1]
        annot-span $w "etymology" "style:fg" $color_germanic "ety:origin" "Germanic"
        continue
    }

    if [word_in_list $txt $latin_words] {
        set! word_count [+ $word_count 1]
        annot-span $w "etymology" "style:fg" $color_latin "ety:origin" "Latin"
        continue
    }

    if [word_in_list $txt $greek_words] {
        set! word_count [+ $word_count 1]
        annot-span $w "etymology" "style:fg" $color_greek "ety:origin" "Greek"
        continue
    }
}

puts "DEBUG: total annotations attempted = $word_count"

;; Verify annotations exist by querying them
let annots_at_0 [weft::annot::in-range 0 100 "etymology"]
puts "DEBUG: etymology annotations in first 100 bytes = $annots_at_0"
