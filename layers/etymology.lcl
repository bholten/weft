;; === Helper Functions ===

let word_chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

proc is_word_char {ch} {
    return [>= [String::find $word_chars $ch] 0]
}

;; Check if word is in a list (case-insensitive)
proc word_in_list {word lst} {
    let lower_word [String::lower $word]
    foreach w $lst {
        if [== $lower_word $w] {
            return 1
        }
    }
    return 0
}

proc add_ety_style {start end color origin} {
    weft::annot::add $start $end "etymology" "style:fg" $color "ety:origin" $origin
}

;; === Main Logic ===

;; Clear previous etymology annotations
weft::annot::clear-layer "etymology"

let doc_len [weft::doc::length]
var pos 0

while [< $pos $doc_len] {
    let ch [weft::doc::text $pos 1]

    ;; Skip non-word characters
    if [not [is_word_char $ch]] {
        set! pos [+ $pos 1]
        continue
    }

    ;; Check if at start of a word
    var at_start 1
    if [> $pos 0] {
        let prev [weft::doc::text [- $pos 1] 1]
        if [is_word_char $prev] {
            set! at_start 0
        }
    }

    if [$at_start] {
        ;; Find word boundaries
        let word_start $pos
        var word_end [+ $pos 1]
        while [< $word_end $doc_len] {
            let c [weft::doc::text $word_end 1]
            if [not [is_word_char $c]] { break }
            set! word_end [+ $word_end 1]
        }

        let word_len [- $word_end $word_start]
        let word [weft::doc::text $word_start $word_len]

        ;; Only process words 2+ characters
        if [>= $word_len 2] {
            ;; Check etymology
            if [word_in_list $word $germanic_words] {
                add_ety_style $word_start $word_end $color_germanic "Germanic"
            } elseif [word_in_list $word $latin_words] {
                add_ety_style $word_start $word_end $color_latin "Latin"
            } elseif [word_in_list $word $greek_words] {
                add_ety_style $word_start $word_end $color_greek "Greek"
            }
        }

        set! pos $word_end
        continue
    }

    set! pos [+ $pos 1]
}
