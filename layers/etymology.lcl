;; ============================================================================
;; Etymology Layer for Weft - Word Origin Highlighting
;; ============================================================================
;;
;; Highlights words by etymology:
;;   - Germanic (Old English, Norse) - warm amber (#D4A574)
;;   - Latin/Romance (via French/Latin) - cool blue (#7B9EC4)
;;   - Greek (scholarly/technical) - purple (#A87BC4)
;;
;; Germanic words feel more direct, visceral, concrete.
;; Latin/Romance words feel more formal, intellectual, abstract.
;; Greek words feel scholarly, technical, philosophical.
;;
;; For novelists: word origin affects the "feel" of prose.
;;   "Help!" (Germanic) vs "Assist!" (Latin) - same meaning, different texture
;;   "Gut feeling" (Germanic) vs "Intuition" (Latin)
;;   "Kingly" (Germanic) vs "Royal" (Latin) vs "Regal" (Latin)
;;
;; ============================================================================

;; === Color Definitions ===

let color_germanic "#D4A574"
let color_latin    "#7B9EC4"
let color_greek    "#A87BC4"

;; === Word Lists ===
;; Note: Cannot use comments inside (...) list literals - they break parsing

