project sp

globals {
    set CC cc
    set LINK_OPTS [list -lcbor]
    set SOURCE [normalize-files {*}[glob *.c *.h]]
    set OUT [file normalize build/sp]
    set STANDARD_OPTS [list -std=c11 -Os -D_POSIX_C_SOURCE=200809L \
			   -Wall -Wextra -Wpedantic -D_GNU_SOURCE \
			   -Wstrict-overflow -fno-strict-aliasing]
    set DEBUG_OPTS   [list -g3 -O0 -fno-omit-frame-pointer -fno-inline -DDEBUG \
			  -fsanitize=address,undefined {*}$STANDARD_OPTS]
    set RELEASE_OPTS [list -O2 -DNDEBUG -s -march=native {*}$STANDARD_OPTS]
}

task setup {
    run {
	mkdir -p build
    }
}

task fmt {
    inputs $sp::SOURCE
    outputs [file normalize ../.clang-format]
    run {
	set -e
	clang-format -i $sp::SOURCE
	touch $sp::fmt::outputs
    }
}

task debug {
    depends_on sp::setup
    inputs $sp::SOURCE
    outputs $sp::OUT
    run {
	$sp::CC $sp::SOURCE $sp::LINK_OPTS $sp::DEBUG_OPTS -o $sp::OUT
    }
}

task bear {
    depends_on sp::debug
    inputs $sp::SOURCE
    outputs compile_commands.json
    run {
	bear -- [string trim ${sp::debug::run}]
    }
}

globals {
    set DEMO_IN [normalize-files sp_client.c sp.h sp_pub.c \
		     sp_sub.c sp_utils.h sp_utils.c tmp/test_client.c]
    set DEMO_OPTS [list -std=c11 -O2 -Wall -Wextra -D_GNU_SOURCE]
   
}

task demo_sub {
    inputs $sp::DEMO_IN
    outputs [file normalize sp_sub_demo]
    run {
	set -e
	cc $sp::DEMO_OPTS -DBUILD_SUB $sp::demo_sub::inputs -o $sp::demo_sub::outputs -lcbor
    }
}

task demo_pub {
    inputs $sp::DEMO_IN
    outputs [file normalize sp_pub_demo]
    run {
	set -e
	cc $sp::DEMO_OPTS -DBUILD_PUB $sp::demo_pub::inputs -o $sp::demo_pub::outputs -lcbor
    }
}
