;;; weft::linediff -- two buffers compared line by line, as a
;;; derivation
;;;
;;; The engine is Myers' O((N+M)D) edit script over LINES, after
;;; trimming the common prefix and suffix (which is most of any two
;;; versions of one text).  It yields ops #{op keep|del|add a <i> b
;;; <j>} -- indices into the two line lists -- which rows! renders as
;;; a unified diff: hunk headers, ` `/`-`/`+` rows, every row a qjump
;;; into the side it came from (`-` and context into A, `+` into B).
;;; `weft::diff a b` defines the derivation `diff:<a>:<b>` over the
;;; two buffers; it goes stale when either moves and refreshes from
;;; the tag.

namespace weft::linediff {

    var context 3

    ;; Lines of a text, without the trailing phantom an ending
    ;; newline would produce.
    proc lines {text} {
        let parts [String::split $text "\n"]

        if [and [> [len $parts] 0] \
                [empty? [get $parts [- [len $parts] 1]]]] {
            return [List::slice $parts 0 [- [len $parts] 1]]
        }

        return $parts
    }

    ;; Myers' middle-snake-free forward algorithm with the trace of V
    ;; per D, then a backtrack -- the textbook form.  `a` and `b` are
    ;; line lists.  Returns the op list in order.
    proc ops {a b} {
        let n [len $a]
        let m [len $b]

        ;; Common prefix / suffix.
        var pre 0

        while [and [< $pre $n] [and [< $pre $m] \
                [== [get $a $pre] [get $b $pre]]]] {
            set! pre [+ $pre 1]
        }

        var suf 0

        while [and [< [+ $pre $suf] $n] [and [< [+ $pre $suf] $m] \
                [== [get $a [- $n [+ $suf 1]]] [get $b [- $m [+ $suf 1]]]]]] {
            set! suf [+ $suf 1]
        }

        var out ()
        var i 0

        while [< $i $pre] {
            set! out [List::push $out #{op keep a $i b $i}]
            set! i [+ $i 1]
        }

        let an [- $n [+ $pre $suf]]
        let bm [- $m [+ $pre $suf]]

        if [or [> $an 0] [> $bm 0]] {
            let mid [weft::linediff::_myers [List::slice $a $pre [+ $pre $an]] \
                [List::slice $b $pre [+ $pre $bm]]]

            foreach o $mid {
                var oo [put $o a [+ [get $o a] $pre]]
                set! oo [put $oo b [+ [get $oo b] $pre]]
                set! out [List::push $out $oo]
            }
        }

        var k 0

        while [< $k $suf] {
            set! out [List::push $out #{op keep
                a [+ [- $n $suf] $k] b [+ [- $m $suf] $k]}]
            set! k [+ $k 1]
        }

        return $out
    }

    ;; V is a dict keyed by k (ints as strings); the trace is one V
    ;; per D for the backtrack.
    proc _myers {a b} {
        let n [len $a]
        let m [len $b]
        let max [+ $n $m]
        var v #{"1" 0}
        var trace ()
        var d 0
        var done 0

        while [and [not $done] [<= $d $max]] {
            set! trace [List::push $trace $v]
            var k [- 0 $d]

            while [and [not $done] [<= $k $d]] {
                var x 0

                if [or [== $k [- 0 $d]] \
                       [and [not [== $k $d]] \
                            [< [weft::linediff::_vget $v [- $k 1]] \
                               [weft::linediff::_vget $v [+ $k 1]]]]] {
                    set! x [weft::linediff::_vget $v [+ $k 1]]
                } else {
                    set! x [+ [weft::linediff::_vget $v [- $k 1]] 1]
                }

                var y [- $x $k]

                while [and [< $x $n] [and [< $y $m] \
                        [== [get $a $x] [get $b $y]]]] {
                    set! x [+ $x 1]
                    set! y [+ $y 1]
                }

                set! v [put $v [String::from $k] $x]

                if [and [>= $x $n] [>= $y $m]] { set! done 1 }

                set! k [+ $k 2]
            }

            if [not $done] { set! d [+ $d 1] }
        }

        ;; Backtrack from (n, m) through the trace.
        var ops ()
        var x $n
        var y $m
        var dd $d

        while [> $dd 0] {
            let pv [get $trace $dd]
            let k [- $x $y]
            var pk 0

            if [or [== $k [- 0 $dd]] \
                   [and [not [== $k $dd]] \
                        [< [weft::linediff::_vget $pv [- $k 1]] \
                           [weft::linediff::_vget $pv [+ $k 1]]]]] {
                set! pk [+ $k 1]
            } else {
                set! pk [- $k 1]
            }

            let px [weft::linediff::_vget $pv $pk]
            let py [- $px $pk]

            while [and [> $x $px] [> $y $py]] {
                set! x [- $x 1]
                set! y [- $y 1]
                set! ops [List::push $ops #{op keep a $x b $y}]
            }

            if [== $x $px] {
                set! ops [List::push $ops #{op add a $x b [- $y 1]}]
                set! y [- $y 1]
            } else {
                set! ops [List::push $ops #{op del a [- $x 1] b $y}]
                set! x [- $x 1]
            }

            set! dd [- $dd 1]
        }

        while [and [> $x 0] [> $y 0]] {
            set! x [- $x 1]
            set! y [- $y 1]
            set! ops [List::push $ops #{op keep a $x b $y}]
        }

        return [List::reverse $ops]
    }

    proc _vget {v k} {
        let key [String::from $k]

        if [has? $v $key] { return [get $v $key] }

        return 0
    }

    ;; Line offsets of a text: start of each line (byte), plus the
    ;; end, so line i spans [starts[i], starts[i+1]) incl. newline.
    proc _line-starts {text} {
        var starts (0)
        var i 0
        let n [String::length $text]

        while [< $i $n] {
            if [== [String::index $text $i] "\n"] {
                set! starts [List::push $starts [+ $i 1]]
            }

            set! i [+ $i 1]
        }

        if [not [== [get $starts [- [len $starts] 1]] $n]] {
            set! starts [List::push $starts $n]
        }

        return $starts
    }

    ;; Group ops into hunks with `context` lines around each change.
    ;; Returns a list of (start end) index ranges into ops.
    proc _hunks {ops} {
        var changed ()
        var i 0

        foreach o $ops {
            if [not [== keep [get $o op]]] {
                set! changed [List::push $changed $i]
            }

            set! i [+ $i 1]
        }

        if [== 0 [len $changed]] { return () }

        var hunks ()
        var hs [- [get $changed 0] $context]
        var he [+ [get $changed 0] [+ $context 1]]

        if [< $hs 0] { set! hs 0 }

        foreach c $changed {
            if [> [- $c $context] $he] {
                set! hunks [List::push $hunks [list $hs [weft::linediff::_min $he [len $ops]]]]
                set! hs [- $c $context]
            }

            set! he [+ $c [+ $context 1]]
        }

        set! hunks [List::push $hunks [list $hs [weft::linediff::_min $he [len $ops]]]]

        return $hunks
    }

    proc _min {x y} {
        if [< $x $y] { return $x }

        return $y
    }

    ;; Emit the unified diff of buffers `ba` and `bb` through the
    ;; sink into `out`; every row jumps to the line it came from.
    ;; Returns "" (the rows are the result; a derivation program's
    ;; value would otherwise print as one more row).
    proc rows! {out ba bb} {
        let ta [Lk::doc_text [weft::ws::buffer-doc $ba]]
        let tb [Lk::doc_text [weft::ws::buffer-doc $bb]]
        let la [weft::linediff::lines $ta]
        let lb [weft::linediff::lines $tb]
        let sa [weft::linediff::_line-starts $ta]
        let sb [weft::linediff::_line-starts $tb]
        let na [get [weft::ws::buffer $ba] name]
        let nb [get [weft::ws::buffer $bb] name]
        let ops [weft::linediff::ops $la $lb]
        let hunks [weft::linediff::_hunks $ops]
        var changed 0

        weft::sink::emit! $out "--- $na\n" \
            #{layer {qjump} meta #{kind {diff-side} side a}
                present #{ptype {qjump} value #{buffer $ba start 0 end 0}}}
        weft::sink::emit! $out "+++ $nb\n" \
            #{layer {qjump} meta #{kind {diff-side} side b}
                present #{ptype {qjump} value #{buffer $bb start 0 end 0}}}

        if [== 0 [len $hunks]] {
            weft::sink::emit! $out "(no differences)\n"

            return ""
        }

        foreach h $hunks {
            let hs [get $h 0]
            let he [get $h 1]
            var a0 -1
            var b0 -1
            var an 0
            var bn 0
            var j $hs

            while [< $j $he] {
                let o [get $ops $j]

                if [not [== add [get $o op]]] {
                    if [< $a0 0] { set! a0 [get $o a] }

                    set! an [+ $an 1]
                }

                if [not [== del [get $o op]]] {
                    if [< $b0 0] { set! b0 [get $o b] }

                    set! bn [+ $bn 1]
                }

                set! j [+ $j 1]
            }

            if [< $a0 0] { set! a0 [get [get $ops $hs] a] }
            if [< $b0 0] { set! b0 [get [get $ops $hs] b] }

            weft::sink::emit! $out "@@ -[+ $a0 1],$an +[+ $b0 1],$bn @@\n"

            set! j $hs

            while [< $j $he] {
                let o [get $ops $j]
                var prefix " "
                var side $ba
                var starts $sa
                var li [get $o a]
                var text ""

                if [== del [get $o op]] {
                    set! prefix "-"
                    set! text [get $la [get $o a]]
                    set! changed [+ $changed 1]
                } else {
                    if [== add [get $o op]] {
                        set! prefix "+"
                        set! side $bb
                        set! starts $sb
                        set! li [get $o b]
                        set! text [get $lb [get $o b]]
                        set! changed [+ $changed 1]
                    } else {
                        set! text [get $la [get $o a]]
                    }
                }

                weft::sink::emit! $out "$prefix$text\n" \
                    #{layer {qjump} meta #{kind {diff-row} op [get $o op]}
                        present #{ptype {qjump}
                            value #{buffer $side start [get $starts $li]
                                end [get $starts [+ $li 1]]}}}
                set! j [+ $j 1]
            }
        }

        return ""
    }
}
