;;; The shell's INTENTS -- what a chord can fire -- as data, plus the
;;; mouse gestures it owns.  This file is the reflective half of
;;; shell.lcl's `on` handlers: every intent named here has a handler
;;; there (test/keys-gates.lcl scans for it), every handler a chord
;;; can reach is named here, and the shell registers lk `keybinding`
;;; rows from `weft::keymap::table`, never by hand.  It touches no
;;; widget, so gates load it headless.
;;;
;;; Chords are NOT here: config/bindings-native.lcl maps them
;;; (`weft::keymap::chord! "ctrl+s" Save`) -- commands and intents are
;;; portable, chords are a host profile.

namespace weft::shell {

    ;; (name scope group doc form) -- scope may be a list for an
    ;; intent that lives in several bars.
    var _intent_table (
        (Save pane {Buffers and panes}
            {save this buffer} {})
        (SplitH pane {Buffers and panes}
            {split this pane side by side, showing the same buffer} {weft::split-h})
        (SplitV pane {Buffers and panes}
            {split this pane stacked, likewise} {weft::split-v})
        (ClosePane pane {Buffers and panes}
            {close this pane -- its buffer stays open} {})
        (NextPane pane {Buffers and panes}
            {focus the next pane} {})
        (NextBuffer pane {Buffers and panes}
            {show the next buffer in this pane} {})
        (OpenBar pane {Buffers and panes}
            {open or create a file -- the bar starts with this buffer's cwd} {})
        (ReplOpen pane {Buffers and panes}
            {the *lcl* REPL (execute weft::repl::attach in a buffer to eval IN it)} {})
        (ShellOpen pane {Buffers and panes}
            {the *shell* buffer -- an ordinary buffer with its own cwd, so cd sticks} {})
        (Inspect pane {Buffers and panes}
            {inspect the annotations at the cursor} {})
        (AnnotEdit pane {Buffers and panes}
            {edit the annotations at the cursor as text} {weft::annot::edit-at})

        (Execute pane {Execute}
            {EXECUTE the selection, else the cursor's line (N selections = N runs, in order)} {})
        (ExecuteWith pane {Execute}
            {EXECUTE WITH: the cursor's line is the program, the selection its operand (this pane's if outside the line, else the previously focused pane's)} {})
        (ExecuteHere pane {Execute}
            {EXECUTE HERE: output lands at this buffer's tail instead of *output*} {})

        (SearchOpen pane {Bars -- inside one, return submits and escape closes}
            {find: live search from the cursor} {})
        (ReplaceOpen pane {Bars -- inside one, return submits and escape closes}
            {find and replace} {})
        (GotoOpen pane {Bars -- inside one, return submits and escape closes}
            {go to a line} {})
        (FilterOpen pane {Bars -- inside one, return submits and escape closes}
            {filter the selection through a program: |cmd  <cmd  >cmd  (bare text is |)} {})
        (SearchNext search_edit {Bars -- inside one, return submits and escape closes}
            {find bar: the next match} {})
        (ReplaceOne replace_edit {Bars -- inside one, return submits and escape closes}
            {replace bar: replace this match, find the next} {})
        (ReplaceAll replace_edit {Bars -- inside one, return submits and escape closes}
            {replace bar: replace every match} {})
        (GotoJump goto_edit {Bars -- inside one, return submits and escape closes}
            {goto bar: jump} {})
        (TransformSubmit transform_edit {Bars -- inside one, return submits and escape closes}
            {transform prompt: run it} {})
        (OpenSubmit open_edit {Bars -- inside one, return submits and escape closes}
            {open bar: open the path, or create it as a (new) buffer} {})
        (ShowSubmit show_edit {Bars -- inside one, return submits and escape closes}
            {buffer bar: show the chosen buffer (fuzzy)} {})
        (FilterSubmit filter_edit {Bars -- inside one, return submits and escape closes}
            {filter bar: run} {})
        (BarClose (search_edit replace_edit goto_edit transform_edit
                   open_edit show_edit filter_edit)
            {Bars -- inside one, return submits and escape closes}
            {close the bar, back to the pane} {}))

    var _gesture_table (
        ({middle-click}
            {EXECUTE the word under the pointer (the selection, when clicked inside it); outside a selection the word runs WITH the selection as its operand})
        ({right-click}
            {LOOK: a plumbed range, qjump row or verified location acts; a bare word finds its next occurrence})
        ({shift+right-click}
            {LOOK, opening the result in a new pane beside this one})
        ({drag a split border}
            {resize -- the workspace owns the ratio}))

    ;; Declare every intent and gesture into weft::keymap.  Idempotent
    ;; (intent! redeclares by name); the shell calls it before its
    ;; first frame, gates call it to resolve the profile headless.
    proc intents! {} {
        foreach row $_intent_table {
            weft::keymap::intent! [get $row 0] \
                #{scope [get $row 1] group [get $row 2] \
                  doc [get $row 3] form [get $row 4]}
        }

        if [empty? [weft::keymap::gestures]] {
            foreach g $_gesture_table {
                weft::keymap::gesture! [get $g 0] [get $g 1]
            }
        }

        return [len $_intent_table]
    }
}
