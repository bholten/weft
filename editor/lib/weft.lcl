;; weft.lcl - Weft Standard Library
;; This file is embedded in the binary and loaded at startup.
;; It provides convenient aliases and utilities for text manipulation.

;; === String Aliases ===
;; These make common string operations more accessible at the top level.

proc upper {s} { String::upper $s }
proc lower {s} { String::lower $s }
proc trim {s} { String::trim $s }
proc split {s sep} { String::split $s $sep }
proc join {lst sep} { String::join $lst $sep }
proc replace {s old new} { String::replace $s $old $new }
proc find {s sub} { String::find $s $sub }

;; === String Conveniences ===
;; Higher-level operations built on the primitives.

;; Split text into lines - works on strings or context dicts (buffer/sel)
;; On strings: returns list of line strings
;; On contexts: returns list of span dicts {text "..." start N end N buffer ID}
proc lines {input} {
  if [string? $input] {
    ;; Plain string - return list of strings
    String::split $input "\n"
  } else {
    if [dict? $input] {
      ;; Context dict - return spans with positions
      let text [get $input "text"]
      let base_start [get $input "start"]
      let buf_id [get $input "buffer"]
      var result ()
      var pos 0
      var line_start 0
      let text_len [len $text]

      while [<= $pos $text_len] {
        let at_end [== $pos $text_len]
        let ch [if $at_end { "" } { String::index $text $pos }]

        if [or $at_end [== $ch "\n"]] {
          let line_text [String::range $text $line_start $pos]
          let span #{
            text $line_text
            start [+ $base_start $line_start]
            end [+ $base_start $pos]
            buffer $buf_id
          }
          set! result [List::push $result $span]
          set! line_start [+ $pos 1]
        }
        set! pos [+ $pos 1]
      }
      $result
    } else {
      ;; Unknown type - try as string
      String::split $input "\n"
    }
  }
}

;; Split text into words - works on strings or context dicts (buffer/sel)
;; On strings: returns list of word strings
;; On contexts: returns list of span dicts {text "..." start N end N buffer ID}
proc words {input} {
  if [string? $input] {
    ;; Plain string - return list of strings (split on whitespace)
    let trimmed [String::trim $input]
    if [== $trimmed ""] { return () }
    String::split $trimmed " "
  } else {
    if [dict? $input] {
      ;; Context dict - return spans with positions
      let text [get $input "text"]
      let base_start [get $input "start"]
      let buf_id [get $input "buffer"]
      let word_chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
      var result ()
      var pos 0
      let text_len [len $text]

      while [< $pos $text_len] {
        let ch [String::index $text $pos]

        ;; Skip non-word characters
        if [< [String::find $word_chars $ch] 0] {
          set! pos [+ $pos 1]
          continue
        }

        ;; Found start of word - find end
        let word_start $pos
        while [< $pos $text_len] {
          let c [String::index $text $pos]
          if [< [String::find $word_chars $c] 0] { break }
          set! pos [+ $pos 1]
        }

        let word_text [String::range $text $word_start $pos]
        let span #{
          text $word_text
          start [+ $base_start $word_start]
          end [+ $base_start $pos]
          buffer $buf_id
        }
        set! result [List::push $result $span]
      }
      $result
    } else {
      ;; Unknown type - try as string
      let trimmed [String::trim $input]
      if [== $trimmed ""] { return () }
      String::split $trimmed " "
    }
  }
}

;; Check if text contains a substring
proc contains? {s sub} { != [String::find $s $sub] -1 }

;; Check if text starts with a prefix
proc starts-with? {s prefix} {
  let plen [len $prefix]
  if [> $plen [len $s]] { return 0 }
  == [String::range $s 0 $plen] $prefix
}

;; Check if text ends with a suffix
proc ends-with? {s suffix} {
  let slen [len $suffix]
  let tlen [len $s]
  if [> $slen $tlen] { return 0 }
  == [String::range $s [- $tlen $slen] $tlen] $suffix
}

;; Concatenate strings (variadic-ish via list)
proc concat-all {lst} { String::join $lst "" }

;; Repeat a string n times
proc repeat {s n} {
  var result ""
  var i 0
  while [< $i $n] {
    set! result [str $result $s]
    set! i [+ $i 1]
  }
  $result
}

;; Pad string on the left to reach target length
proc pad-left {s width {char " "}} {
  let slen [len $s]
  if [>= $slen $width] { return $s }
  str [repeat $char [- $width $slen]] $s
}

;; Pad string on the right to reach target length
proc pad-right {s width {char " "}} {
  let slen [len $s]
  if [>= $slen $width] { return $s }
  str $s [repeat $char [- $width $slen]]
}

;; === List Conveniences ===

;; Get first element of list
proc first {lst} { get $lst 0 }

;; Get last element of list
proc last {lst} { get $lst [- [len $lst] 1] }

;; Get all but first element
proc rest {lst} { List::slice $lst 1 [len $lst] }

;; Get all but last element
proc butlast {lst} { List::slice $lst 0 [- [len $lst] 1] }

;; Take first n elements
proc take {lst n} { List::slice $lst 0 $n }

;; Drop first n elements
proc drop {lst n} { List::slice $lst $n [len $lst] }

;; === Numeric Conveniences ===

;; Clamp a value to a range
proc clamp {val min max} {
  if [< $val $min] { return $min }
  if [> $val $max] { return $max }
  $val
}

;; Absolute value
proc abs {n} {
  if [< $n 0] { - 0 $n } { $n }
}

;; Minimum of two values
proc min {a b} {
  if [< $a $b] { $a } { $b }
}

;; Maximum of two values
proc max {a b} {
  if [> $a $b] { $a } { $b }
}

;; === Regex Conveniences ===
;; Uses POSIX Extended Regular Expressions (ERE).
;; Pattern matches anywhere in string (use ^...$ for full match).

;; Check if string matches a regex pattern
;; Returns 1 if matched, 0 if not
proc match? {pattern s} { regex::match $pattern $s }

;; Check if string matches any pattern in a list
proc matches-any? {patterns s} {
  foreach p $patterns {
    if [regex::match $p $s] { return 1 }
  }
  0
}

;; Filter list to items matching a pattern
proc filter-match {pattern lst} {
  var result {}
  foreach item $lst {
    if [regex::match $pattern $item] {
      set! result [List::push $result $item]
    }
  }
  $result
}

;; Filter list to items NOT matching a pattern
proc filter-reject {pattern lst} {
  var result {}
  foreach item $lst {
    if [not [regex::match $pattern $item]] {
      set! result [List::push $result $item]
    }
  }
  $result
}

;; === Transform DSL ===
;; Allows string functions to work seamlessly with selections and buffers.
;; When called with a transform context, they show a diff preview.
;; When called with a plain string, they return the transformed string.

;; Check if a value is a transform context (dict with start, end, buffer, text)
;; This is also the structure for spans returned by words/lines
proc transform-ctx? {val} {
  if [not [dict? $val]] { return 0 }
  if [not [has? $val "start"]] { return 0 }
  if [not [has? $val "text"]] { return 0 }
  1
}

;; Alias: check if value is a span (same structure as transform context)
proc span? {val} { transform-ctx? $val }

;; Add annotation to a span - convenience for working with words/lines results
;; Usage: annot-span $span "layer" "key1" "val1" "key2" "val2" ...
;; Supports 0, 2, 4, or 6 key-value arguments
proc annot-span {span layer *args} {
    if [not [span? $span]] {
        error "annot-span: first argument must be a span"
    }

    let start [get $span "start"]
    let end [get $span "end"]
    let argc [len $args]

    if [== $argc 0] {
        weft::annot::add $start $end $layer
    } else {
        weft::annot::add $start $end $layer @$args
    }
}

;; Get selection as a transform context
;; Returns {start N end N buffer N text "..."} or empty list if no selection
proc sel {} { weft::sel::info }

;; Get entire buffer as a transform context
proc buffer {} {
    let l [weft::doc::length]
    let text [weft::doc::text 0 $l]
    let id [weft::buffer::id]
    #{start 0 end $l buffer $id text $text}
}

;; Apply a string function to input, showing diff if input is a context
;; fn: a proc that takes a string and returns a string
;; input: either a string or a transform context
proc make-transform {fn input} {
  if [transform-ctx? $input] {
    let text [get $input "text"]
    let result [$fn $text]
    weft::transform::apply-ctx $input $result
  } else {
    $fn $input
  }
}

;; === Context-Aware Transforms ===
;; These functions work with both plain strings and selection/buffer contexts.

;; Uppercase - works with strings or contexts
proc upper {input} { make-transform String::upper $input }

;; Lowercase - works with strings or contexts
proc lower {input} { make-transform String::lower $input }

;; Trim whitespace - works with strings or contexts
proc trim {input} { make-transform String::trim $input }

;; Sort lines - works with strings or contexts
proc sort-lines {input} {
  proc do-sort {s} {
    let lns [lines $s]
    let sorted [List::sort $lns]
    join $sorted "\n"
  }
  make-transform do-sort $input
}

;; Reverse lines - works with strings or contexts
proc reverse-lines {input} {
  proc do-reverse {s} {
    let lns [lines $s]
    let reversed [List::reverse $lns]
    join $reversed "\n"
  }
  make-transform do-reverse $input
}

;; === Acme-style Execution ===

;; Execute a single command in Acme style
;; Handles: [expr], weft:: commands, load, file paths, shell commands
;; Returns 1 if executed, 0 if empty/skipped
proc acme-exec {text} {
  let trimmed [trim $text]
  if [== $trimmed ""] { return 0 }

  ;; Check for Lcl expression [...] - execute as Lcl
  ;; This is first because [...] is the explicit "this is Lcl" syntax
  if [starts-with? $trimmed "\["] {
    eval $trimmed
    return 1
  }

  ;; Check for weft:: command (execute as Lcl)
  if [starts-with? $trimmed "weft::"] {
    eval $trimmed
    return 1
  }

  ;; Check for load command (execute as Lcl)
  if [starts-with? $trimmed "load "] {
    eval $trimmed
    return 1
  }

  ;; Check for absolute file path (starts with /)
  if [starts-with? $trimmed "/"] {
    weft::buffer::open $trimmed
    return 1
  }

  ;; Everything else: execute as shell command
  let result [weft::shell::exec $trimmed]
  let stdout [List::index $result 3]
  let stderr [List::index $result 5]

  if [> [len $stdout] 0] {
    weft::buffer::open-output [String::join ("+" $trimmed) ""] $stdout
  } else {
    if [> [len $stderr] 0] {
      weft::buffer::open-output [String::join ("!" $trimmed) ""] $stderr
    }
  }
  return 1
}

;; Execute multiple lines in Acme style
;; Splits text by newlines and executes each non-empty line
proc acme-exec-lines {text} {
    let text_lines [lines $text]
  
    foreach line $text_lines {
        acme-exec $line
    }
}
