;; Demo highlight layer
;; Highlights specific words with colors

;; Get document length and iterate through each line
let line_count [weft::doc::line-count]

;; Simple word highlighting - iterate through lines
proc highlight_word {word color} {
    let doc_len [weft::doc::length]
    let pos 0
    let word_len [String::len $word]

    ;; Search for word in document
    while {< $pos $doc_len} {
        let text [weft::doc::text $pos $word_len]
        if {eq $text $word} {
            weft::annot::add $pos [+ $pos $word_len] "highlight" "style:fg" $color
        }
        set! pos [+ $pos 1]
    }
}

;; Highlight some demo words
highlight_word "Hello" "magenta"
highlight_word "Weft" "cyan"
highlight_word "styled" "yellow"
